{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ainone-ui",
  "version": "0.2.0",
  "identifier": "com.zhubaoduo.ainone-ui",
  "build": {
    "beforeDevCommand": "pnpm dev:port",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ainone-ui",
        "width": 800,
        "height": 600,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "resources/runtime-versions.json",
      "resources/runtime/**"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
